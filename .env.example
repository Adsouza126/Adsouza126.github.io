# ──────────────────────────────────────────────────────────────────────────
# Rally — environment variables
# Copy this file to `.env.local` and fill in your Supabase project values.
# Find these under: Supabase Dashboard → Project Settings → API
# ──────────────────────────────────────────────────────────────────────────

# Public Supabase URL (e.g. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key — safe to expose to the browser (RLS protects your data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The base URL of the app, used for auth email redirects.
# In local dev this is http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service role key — SERVER ONLY. Never expose to the browser.
# Used exclusively by the seed script (`npm run seed`) to create demo users.
SUPABASE_SERVICE_ROLE_KEY=

